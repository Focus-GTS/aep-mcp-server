AEP_CLIENT_ID=your-client-id
AEP_CLIENT_SECRET=your-client-secret
AEP_ORG_ID=your-ims-org-id@AdobeOrg
AEP_SANDBOX_NAME=prod
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Write mode
# ---------------------------------------------------------------------------
# Controls how much this server is allowed to mutate. One of:
#
#   read-only   No write, update, or delete in ANY sandbox. Reads still work.
#               Use when handing the server to someone to explore an
#               environment you do not want touched.
#
#   safe        (DEFAULT) Writes permitted only where Adobe classifies the
#               sandbox as `development`. At startup the server asks Adobe's
#               Sandbox Management API for the real type — it never infers it
#               from the sandbox NAME, because a production sandbox can be
#               named anything. Fails closed: if the type cannot be
#               determined, writes are blocked.
#
#   production  Writes permitted against any sandbox, including production.
#               For teams running their own change control who do not want
#               this server second-guessing them. Logs a warning at startup.
#
# Reads are never restricted by this setting, in any mode.
# An unrecognised value falls back to `safe` — a typo must not grant
# production write access.
#
# AEP_MODE=safe

# Deprecated: equivalent to AEP_MODE=production. Still honoured, but AEP_MODE
# wins if both are set.
# AEP_ALLOW_PRODUCTION_WRITES=true
