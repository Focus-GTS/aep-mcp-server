AEP_CLIENT_ID=your-client-id
AEP_CLIENT_SECRET=your-client-secret
AEP_ORG_ID=your-ims-org-id@AdobeOrg
AEP_SANDBOX_NAME=your-development-sandbox
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Mutations are OFF by default
# ---------------------------------------------------------------------------
# No write, update, or delete tool can execute unless this is explicitly true.
# This is deliberately SEPARATE from AEP_MODE: choosing a write mode is not the
# same as saying "yes, this server may change my data", and one variable should
# not do both jobs.
#
# Leave it unset to explore an environment read-only. Every read tool still
# works.
#
# AEP_ALLOW_MUTATIONS=true

# ---------------------------------------------------------------------------
# The prod-name refusal
# ---------------------------------------------------------------------------
# A sandbox literally NAMED `prod` or `production` is refused for all mutations,
# unconditionally, before write-mode resolution — so AEP_MODE=production does
# NOT lift it.
#
# This is not the same as inferring safety from a name, which the server never
# does. Trusting a name to ALLOW a write is unsafe; trusting one to DENY a write
# is safe, because the worst case is a refusal you can override on purpose.
#
# Only set this if your sandbox is genuinely named `prod` and you truly intend
# to write to it.
#
# AEP_I_UNDERSTAND_THIS_WRITES_TO_PROD=true

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# Logs raw Adobe error response bodies. OFF by default: Adobe echoes request
# context, and on Profile/Identity surfaces that can include identity values,
# which redaction cannot reach inside an opaque string. Turn on only while
# actively debugging a malformed request.
#
# AEP_LOG_RESPONSE_BODIES=true

# ---------------------------------------------------------------------------
# Write mode
# ---------------------------------------------------------------------------
# Controls how much this server is allowed to mutate. One of:
#
#   read-only   No write, update, or delete in ANY sandbox. Reads still work.
#               Use when handing the server to someone to explore an
#               environment you do not want touched.
#
#   safe        (DEFAULT) Writes permitted only where Adobe classifies the
#               sandbox as `development`. At startup the server asks Adobe's
#               Sandbox Management API for the real type — it never infers it
#               from the sandbox NAME, because a production sandbox can be
#               named anything. Fails closed: if the type cannot be
#               determined, writes are blocked.
#
#   production  Writes permitted against any sandbox, including production.
#               For teams running their own change control who do not want
#               this server second-guessing them. Logs a warning at startup.
#
# Reads are never restricted by this setting, in any mode.
# An unrecognised value falls back to `safe` — a typo must not grant
# production write access.
#
# AEP_MODE=safe

# Deprecated: equivalent to AEP_MODE=production. Still honoured, but AEP_MODE
# wins if both are set.
# AEP_ALLOW_PRODUCTION_WRITES=true
