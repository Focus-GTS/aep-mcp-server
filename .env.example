AEP_CLIENT_ID=your-client-id
AEP_CLIENT_SECRET=your-client-secret
AEP_ORG_ID=your-ims-org-id@AdobeOrg
AEP_SANDBOX_NAME=prod
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Production-write guard
# ---------------------------------------------------------------------------
# At startup the server asks Adobe's Sandbox Management API what type the
# configured sandbox actually is. Writes, updates, and deletes are permitted
# ONLY when Adobe classifies it as `development`.
#
# The check is on Adobe's own classification, never the sandbox name — a
# production sandbox can be named anything.
#
# It fails closed: if the type cannot be determined (e.g. the credential
# cannot read sandbox metadata), writes are blocked and reads still work.
#
# Reads are never blocked by this guard, in any sandbox.
#
# Set this ONLY if you deliberately intend to mutate a production sandbox.
# AEP_ALLOW_PRODUCTION_WRITES=true
